{
  "name": "@botuyo/chat-widget-standalone",
  "version": "1.2.1",
  "type": "module",
  "description": "BotUyo Chat Widget - Standalone CDN version with React/TypeScript support",
  "main": "dist/botuyo-chat.umd.js",
  "module": "dist/botuyo-chat.es.js",
  "types": "dist/standalone.d.ts",
  "exports": {
    ".": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/botuyo-chat.es.js",
      "require": "./dist/botuyo-chat.umd.js"
    },
    "./dist/style.css": "./dist/botuyo-chat.css",
    "./style.css": "./dist/botuyo-chat.css"
  },
  "scripts": {
    "dev": "npm run build:css && vite",
    "build": "npm run clean && npm run build:css && npm run build:es && npm run build:umd && npm run build:types",
    "build:css": "npx @tailwindcss/cli -i ./styles.css -o ./src/chat-widget/compiled-tailwind.css --minify",
    "build:es": "vite build",
    "build:umd": "vite build -c vite.config.umd.mjs",
    "build:types": "tsc --project tsconfig.build.json",
    "preview": "vite preview",
    "clean": "npx rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "chat",
    "widget",
    "chatbot",
    "customer-support",
    "botuyo",
    "standalone",
    "cdn",
    "react",
    "typescript",
    "nextjs",
    "socket.io"
  ],
  "author": "BotUyo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/botuyo/chat-widget.git"
  },
  "bugs": {
    "url": "https://github.com/botuyo/chat-widget/issues"
  },
  "homepage": "https://github.com/botuyo/chat-widget#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-onboarding": "^10.2.0",
    "@storybook/addon-vitest": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.11.1",
    "cors": "^2.8.6",
    "cssnano": "^7.1.2",
    "cssnano-preset-advanced": "^7.0.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^10.2.0",
    "globals": "^17.1.0",
    "happy-dom": "^20.3.7",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-sanitize": "^6.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "socket.io": "^4.8.3",
    "storybook": "^10.2.0",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.5",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.182.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.400.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALLATION_GUIDE.md",
    "LICENSE",
    "examples"
  ]
}
