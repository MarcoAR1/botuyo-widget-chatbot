{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "include": [
    "standalone.tsx",
    "src/chat-widget/**/*",
    "src/lib/**/*",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test",
    "node_modules",
    "dist"
  ]
}